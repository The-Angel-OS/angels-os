# ─────────────────────────────────────────────────────────────────────────────
# Node B — the alternative federated Enterprise (kendev.co)
#
# Same repo as Node A (spacesangels.com), deployed as a SEPARATE Vercel project
# with its OWN database + blob store, so the two are sovereign nodes that federate.
# Copy these into the angels-os-kendev Vercel project's Environment Variables.
# See docs/FEDERATION_TESTBED.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity / own URL ──
NEXT_PUBLIC_SERVER_URL=https://kendev.co
DEFAULT_TENANT_SLUG=kendev

# ── Separate database (Node B's own Postgres — NOT the prod DB) ──
DATABASE_URI=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# ── Separate Blob store (Node B's own CAS) ──
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_NODE_B_TOKEN

# ── Payload core (generate a fresh secret for Node B) ──
PAYLOAD_SECRET=GENERATE_A_DIFFERENT_SECRET_FOR_NODE_B
CRON_SECRET=GENERATE_A_DIFFERENT_CRON_SECRET

# ── Federation peering — point Node B at Node A ──
FEDERATION_REGISTRY_URL=https://spacesangels.com
# Relax signature checks for the first handshake, then tighten once keys exchange:
FEDERATION_ALLOW_UNSIGNED_PINGS=true

# ── Keep Node B agent-cold during testing (coordinate, don't auto-think) ──
# Needs the small wire-up noted in docs/FEDERATION_TESTBED.md Follow-ups.
FEDERATION_AGENT_AUTORESPOND=false

# ── AI / email / Stripe — optional for a pure federation testbed ──
# Leave AI keys UNSET on Node B if you only want to test the (token-free) protocol;
# set them only when you want Node B's agents to actually respond.
# AI_GATEWAY_API_KEY=
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=

# On Node A (spacesangels.com), set the reciprocal peer pointer:
#   FEDERATION_REGISTRY_URL=https://kendev.co
