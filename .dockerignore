# Keep the build context small + never bake secrets/artifacts into the image.
node_modules
.next
.git
.github
.vercel
.env
.env.*
!.env.example
# docs/ WAS excluded wholesale, which is why /dashboard/docs reported "0
# documents across 0 categories" — the endpoint reads docs/ off disk and the
# directory was not in the image. The 78MB that justified excluding it is
# entirely binaries: transcripts 31MB, presentations 25MB, images 20MB. The 281
# markdown files the Documentation Center actually serves are 2.5MB, so ship
# those and keep the heavy folders out.
docs/transcripts
docs/presentations
docs/images
*.log
build-out.log
coverage
playwright-report
test-results
tests
.DS_Store
scratchpad
# Dev/editor/tooling detritus — never referenced by `next build` or the runtime.
# Trims the build context; the image bulk is node_modules (deps), not these.
.cursor
.vscode
.storybook
.opencode
.claude
.github-issues
.bible-tmp
.hintrc
mcp-server
*.md
!README.md
