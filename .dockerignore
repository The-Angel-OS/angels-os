# Keep the build context small + never bake secrets/artifacts into the image.
node_modules
.next
.git
.github
.vercel
.env
.env.*
!.env.example
docs
*.log
build-out.log
coverage
playwright-report
test-results
tests
.DS_Store
scratchpad
# Dev/editor/tooling detritus — never referenced by `next build` or the runtime.
# Trims the build context; the image bulk is node_modules (deps), not these.
.cursor
.vscode
.storybook
.opencode
.claude
.github-issues
.bible-tmp
.hintrc
mcp-server
*.md
!README.md
