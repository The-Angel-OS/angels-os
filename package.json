    "@storybook/react": "^10.2.10",
    "@tailwindcss/postcss": "4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/react": "16.3.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "22.5.4",
