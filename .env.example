# Angel OS Environment Configuration
# Copy to .env.local (Next.js) OR .env (for pnpm dev via scripts/dev-with-env.mjs)
# If PAYLOAD_SECRET is missing, ensure .env exists with at least PAYLOAD_SECRET and DATABASE_URI

# Database Configuration
DATABASE_URI=postgresql://your_user:your_password@your_host:5432/your_database

# Payload CMS Configuration
PAYLOAD_SECRET=your-payload-secret-here

# Stripe Configuration
STRIPE_SECRET_KEY=your-stripe-secret-key-here
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key-here
STRIPE_WEBHOOKS_SIGNING_SECRET=your-stripe-webhooks-signing-secret-here

# Live Preview (set a random string, e.g. openssl rand -hex 32)
PREVIEW_SECRET=your-random-preview-secret

# Application URLs - Update these for Vercel deployment
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# For Vercel deployment, update these to:
# NEXT_PUBLIC_SERVER_URL=https://your-app-domain.com
# PAYLOAD_PUBLIC_SERVER_URL=https://your-app-domain.com

# Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn-here

# LiveKit Configuration
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
NEXT_PUBLIC_LIVEKIT_URL=wss://your-livekit-url.livekit.cloud

# Deepgram API
DEEPGRAM_API_KEY=your-deepgram-api-key
NEETS_API_KEY=your-neets-api-key

# Groq API
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI API
OPENAI_API_KEY=your-openai-api-key

# Anthropic API (LEO's brain)
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenRouter API (image generation + multi-model routing)
OPENROUTER_API_KEY=your-openrouter-api-key

# ElevenLabs API
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key

# Google Recaptcha Secret
GOOGLE_RECAPTCHA_SECRET=your-recaptcha-secret

# GitHub OAuth
GITHUB_ID=your-github-oauth-id
GITHUB_SECRET=your-github-oauth-secret

# Vercel Blob Storage Token
BLOB_READ_WRITE_TOKEN=your-vercel-blob-token
PAYLOAD_CONFIG_PATH=src/payload.config.ts

# SMTP Email Configuration (optional — enables invitation emails, password resets, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=Angel OS

# System Email (for email-to-chat bridge)
SYSTEM_EMAIL_ADDRESS=hello@yourdomain.com
SYSTEM_EMAIL_PASSWORD=your-email-password

# Resend API (transactional email)
RESEND_API_KEY=your-resend-api-key

# Cookie Domain (set to your production domain for subdomain sharing)
COOKIE_DOMAIN=.yourdomain.com

# Cron Secret (for securing Vercel cron jobs)
CRON_SECRET=your-cron-secret-here

# Encryption Secret
ENCRYPTION_SECRET=your-encryption-secret-here

# AI Gateway (optional — Vercel AI Gateway for multi-model routing)
AI_GATEWAY_API_KEY=your-ai-gateway-key

# Google Analytics 4 (optional — enables e-commerce event tracking)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Vapi Voice AI (optional — enables phone-based Leo access)
VAPI_PRIVATE_KEY=your-vapi-private-key
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key
VAPI_PHONE_NUMBER=+1XXXXXXXXXX
VAPI_PHONE_NUMBER_ID=your-vapi-phone-number-id
VAPI_WEBHOOK_SECRET=optional-webhook-secret-for-auth
